        "letterSpacing": "{font.letter-spacing.0}"
      },
      "$description": "Hero titles and empty states."
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.600}",
        "fontSize": "{font.size.18}",
        "lineHeight": "{font.line-height.28}",
        "letterSpacing": "{font.letter-spacing.0}"
      },
      "$description": "Section and dialog titles."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontWeight": "{font.weight.400}",
        "fontSize": "{font.size.14}",
